{
  "manifest_version": 2,
  "name": "UOL Comment Blocker",
  "version": "1.0.0",
  "description": "Oculta a área de comentários do UOL Notícias.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "content_scripts": [
    {
      "matches": ["*://noticias.uol.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
